#!/bin/bash
# One-time install and download for pplx-decider-v1.2, run as a job so nothing heavy runs on the login node.
# Submit from decision_models/:   sbatch slurm/setup.sub
# No GPU needed: installs the Python environment and downloads ~52 GB of weights into $WORK_DIR/pplx.
#SBATCH --job-name=pplx-setup
#SBATCH --partition=lil-interns
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=03:00:00
#SBATCH --output=logs/%x-%j.out
set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"
source ./env.sh
echo "WORK_DIR=$WORK_DIR  PPLX_CKPT=$PPLX_CKPT"
df -h "$(dirname "$WORK_DIR")" || true
bash pplx/setup.sh
