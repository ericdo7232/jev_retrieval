#!/bin/bash
# Smoke test of pplx-decider-v1.2 in FP8 on ONE RTX 6000 Ada (48 GB), compared with an earlier bf16 run.
# Submit from decision_models/ (same environment as slurm/pplx-smoke.sub):
#   sbatch slurm/pplx-smoke-ada.sub --reference results/pplx_smoke_<bf16 run>.json
# Extra arguments go to pplx/smoke.py.
# default_partition is preemptible: if the job is preempted, just resubmit it.
#SBATCH --job-name=pplx-smoke-ada
#SBATCH --partition=default_partition
#SBATCH --gres=gpu:nvidia_rtx_6000_ada_generation:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x-%j.out
set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"
source ./env.sh
mkdir -p logs results
PY="$WORK_DIR/pplx/.venv/bin/python"
# Less fragmentation when 27 GB of weights and ~15 GB of activations share 48 GB.
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

echo "Node $(hostname)"
nvidia-smi --query-gpu=name,memory.total,driver_version,compute_cap --format=csv,noheader
"$PY" -c "import torch; print('torch', torch.__version__, 'CUDA', torch.version.cuda, 'available', torch.cuda.is_available(), 'GPUs', torch.cuda.device_count())"
source slurm/triton_tools.sh

"$PY" pplx/smoke.py --checkpoint "$PPLX_CKPT" --fp8 --devices cuda:0 --out results "$@"
