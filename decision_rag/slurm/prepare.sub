#!/bin/bash
# Step 1 (CPU): Python environment, DAPR NQ download (~0.8 GB), page/paragraph tables, first sentences, test sample.
# Submit from decision_rag/:   sbatch slurm/prepare.sub
#SBATCH --job-name=drag-prepare
#SBATCH --partition=lil-interns
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=03:00:00
#SBATCH --output=logs/%x-%j.out
set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"
source ./env.sh
mkdir -p logs
echo "DRAG_DIR=$DRAG_DIR"
bash setup.sh
"$DRAG_DIR/.venv/bin/python" scripts/prepare_data.py --workers "${SLURM_CPUS_PER_TASK:-8}"
